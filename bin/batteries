#!/usr/bin/env python3
"""
Every battery on and around this computer, as one JSON line.

  laptop          the internal battery from /sys/class/power_supply: level,
                  charge or discharge rate, time left, health, cycles, and the
                  charge limit; time estimates come from UPower when it has them
  airpods         AirPods from the librepods daemon's status file (the one
                  omapods reads): each bud and the case, or a Max's one battery

Peripherals, in order (the first source wins when two report one device):
  glorious        Glorious Model O / O- / D / D- Wireless over /dev/hidraw
                  (korkje/mow protocol). On the USB cable the mouse enumerates
                  with its wired PID and is charging; on the 2.4 GHz dongle it
                  reports its level and whether it is asleep.
  glorious-wired  Sinowealth Glorious mice (gloriousctl protocol)
  hyperx          HyperX Cloud Alpha Wireless dongle over /dev/hidraw
  razer           openrazer kernel driver (charge_level in sysfs)
  jbl             JBL speakers the JBL Portable app reads (Charge 5, Boombox 3,
                  ...), over their GATT service on the Bluetooth Classic link
  upower          everything UPower knows: Bluetooth (BlueZ), Logitech HID++,
                  Sony and Nintendo controllers, Apple and Wacom devices, ...
  headsetcontrol  any headset HeadsetControl supports, when it is installed
  iphone          an iPhone or iPad on USB, through libimobiledevice
  kdeconnect      phones paired with KDE Connect

Only the Python standard library is used: HID feature reports go through the
hidraw ioctls directly, so there is no hidapi dependency.

Usage:
  batteries [probe]       JSON for the bar widget
  batteries list          human readable
  batteries install-udev  (as root) grant the seat user hidraw access
"""

from __future__ import annotations

import fcntl
import glob
import json
import os
import re
import select
import shutil
import socket
import struct
import subprocess
import sys
import time
import uuid

HERE = os.path.dirname(os.path.realpath(__file__))
UDEV_RULES = os.path.join(HERE, "..", "udev", "70-omarchy-batteries.rules")
UDEV_DEST = "/etc/udev/rules.d/70-omarchy-batteries.rules"
# Installed by 1.0, when this was Peripheral Battery. Same rules.
UDEV_LEGACY = "/etc/udev/rules.d/70-omarchy-peripheral-battery.rules"

# ---------------------------------------------------------------- hidraw


def _ioc(direction: int, nr: int, size: int) -> int:
    return (direction << 30) | (size << 16) | (ord("H") << 8) | nr


def _hidiocsfeature(size: int) -> int:
    return _ioc(3, 0x06, size)


def _hidiocgfeature(size: int) -> int:
    return _ioc(3, 0x07, size)


def _read_text(path: str) -> str:
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return ""


def hidraw_nodes() -> list[dict]:
    """Every /dev/hidraw* with its bus, VID, PID, name and USB interface."""
    nodes = []
    for sys_path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = _read_text(os.path.join(sys_path, "device", "uevent"))
        m = re.search(r"^HID_ID=([0-9A-Fa-f]+):([0-9A-Fa-f]+):([0-9A-Fa-f]+)$", uevent, re.M)
        if not m:
            continue
        name = re.search(r"^HID_NAME=(.*)$", uevent, re.M)
        # .../3-1:1.2/0003:258A:2011.0007 -> the parent is the USB interface.
        iface_dir = os.path.dirname(os.path.realpath(os.path.join(sys_path, "device")))
        iface = _read_text(os.path.join(iface_dir, "bInterfaceNumber"))
        nodes.append({
            "dev": "/dev/" + os.path.basename(sys_path),
            "bus": int(m.group(1), 16),
            "vid": int(m.group(2), 16),
            "pid": int(m.group(3), 16),
            "name": name.group(1).strip() if name else "",
            "iface": int(iface, 16) if iface else -1,
        })
    return nodes


class NoAccess(Exception):
    pass


def _open(dev: str, flags: int = os.O_RDWR) -> int:
    try:
        return os.open(dev, flags)
    except PermissionError as e:
        raise NoAccess(dev) from e


def feature_exchange(dev: str, request: bytes, reply_id: int, reply_len: int, delay: float = 0.0) -> bytes | None:
    """SET_FEATURE then GET_FEATURE. Both buffers start with the report ID."""
    fd = _open(dev)
    try:
        out = bytearray(request)
        fcntl.ioctl(fd, _hidiocsfeature(len(out)), out, True)
        if delay:
            time.sleep(delay)
        buf = bytearray(reply_len)
        buf[0] = reply_id
        n = fcntl.ioctl(fd, _hidiocgfeature(len(buf)), buf, True)
        return bytes(buf[: n if n > 0 else len(buf)])
    except OSError:
        return None
    finally:
        os.close(fd)


# ------------------------------------------------------- Glorious (mow)

# name, wired (USB cable) PID, wireless (dongle) PID — from korkje/mow
GLORIOUS_WIRELESS = (
    ("Glorious Model O Wireless", 0x2011, 0x2022),
    ("Glorious Model O- Wireless", 0x2013, 0x2024),
    ("Glorious Model D Wireless", 0x2012, 0x2023),
    ("Glorious Model D- Wireless", 0x2014, 0x2025),
)
GLORIOUS_VID = 0x258A
MOW_IFACE = 2
MOW_LEN = 65
# Byte 1 of the reply: active, asleep, ?, ?, waking
MOW_MARKERS = {0xA1: "active", 0xA4: "asleep", 0xA3: "waking"}


def mow_request() -> bytes:
    buf = bytearray(MOW_LEN)
    buf[3] = 0x02
    buf[4] = 0x02
    buf[6] = 0x83
    return bytes(buf)


def parse_mow(resp: bytes | None) -> dict | None:
    """{'state': active|asleep|waking|unknown, 'level': int|None} or None."""
    if not resp or len(resp) < 9 or resp[6] != 0x83:
        return None
    state = MOW_MARKERS.get(resp[1], "unknown")
    level = resp[8]
    if level > 100:
        return None
    if state != "active":
        # Asleep and waking replies carry no fresh level.
        return {"state": state, "level": None}
    return {"state": state, "level": max(1, level)}


def _mow_query(node: dict) -> dict | None:
    return parse_mow(feature_exchange(node["dev"], mow_request(), 0, MOW_LEN, delay=0.05))


def glorious_wireless(nodes: list[dict], denied: list[str]) -> list[dict]:
    out = []
    for name, wired_pid, wireless_pid in GLORIOUS_WIRELESS:
        def pick(pid: int) -> dict | None:
            cands = [n for n in nodes if n["vid"] == GLORIOUS_VID and n["pid"] == pid]
            cands.sort(key=lambda n: (n["iface"] != MOW_IFACE, n["iface"]))
            return cands[0] if cands else None

        cable = pick(wired_pid)
        dongle = pick(wireless_pid)
        if not cable and not dongle:
            continue
        dev = {
            "id": "glorious:%04x" % wireless_pid,
            "name": name,
            "kind": "mouse",
            "source": "glorious",
            "level": None,
            "charging": False,
            "status": "offline",
            "connection": "usb" if cable else "wireless",
        }
        try:
            got = _mow_query(cable) if cable else None
            # The cable enumerates while plugged into this PC, so the mouse
            # is on USB power: charging until it reports 100%.
            if got and got["state"] == "active":
                dev["level"] = got["level"]
                dev["charging"] = got["level"] < 100
                dev["status"] = "charging" if dev["charging"] else "full"
                dev["connection"] = "usb"
            elif dongle:
                got = _mow_query(dongle)
                dev["connection"] = "wireless"
                if got:
                    dev["level"] = got["level"]
                    dev["status"] = "discharging" if got["state"] == "active" else got["state"]
            elif cable:
                dev["status"] = "charging"
                dev["charging"] = True
        except NoAccess as e:
            denied.append(str(e))
            dev["status"] = "no-access"
        out.append(dev)
    return out


# ------------------------------------------ Glorious wired (gloriousctl)

SINO_PIDS = (0x0036,)
SINO_IFACE = 1


def parse_sinowealth(resp: bytes | None) -> dict | None:
    if not resp or len(resp) < 6 or resp[1] != 0x1D or resp[2] > 100:
        return None
    return {"level": resp[2], "charging": bool(resp[3] & 0x01)}


def glorious_wired(nodes: list[dict], denied: list[str]) -> list[dict]:
    out = []
    for pid in SINO_PIDS:
        cands = [n for n in nodes if n["vid"] == GLORIOUS_VID and n["pid"] == pid]
        cands.sort(key=lambda n: (n["iface"] != SINO_IFACE, n["iface"]))
        for node in cands:
            try:
                got = parse_sinowealth(feature_exchange(node["dev"], bytes([0x05, 0x1D, 0, 0, 0, 0]), 0x05, 8))
            except NoAccess as e:
                denied.append(str(e))
                break
            if got:
                out.append({
                    "id": "glorious:%04x" % pid,
                    "name": node["name"] or "Glorious mouse",
                    "kind": "mouse",
                    "source": "glorious-wired",
                    "level": got["level"],
                    "charging": got["charging"],
                    "status": "charging" if got["charging"] else "discharging",
                    "connection": "usb",
                })
                break
    return out


# -------------------------------------------- HyperX Cloud Alpha Wireless

HYPERX_VID = 0x03F0
HYPERX_PID = 0x098D


def parse_hyperx(data: bytes) -> tuple[int | None, bool | None]:
    """Scan input reports for 21 BB 0B <level> and 21 BB 0C <charging>."""
    level, charging = None, None
    for i in range(len(data) - 3):
        if data[i] == 0x21 and data[i + 1] == 0xBB:
            if data[i + 2] == 0x0B and data[i + 3] <= 100:
                level = data[i + 3]
            elif data[i + 2] == 0x0C:
                charging = data[i + 3] == 0x01
    return level, charging


def hyperx(nodes: list[dict], denied: list[str]) -> list[dict]:
    for node in (n for n in nodes if n["vid"] == HYPERX_VID and n["pid"] == HYPERX_PID):
        try:
            fd = _open(node["dev"], os.O_RDWR | os.O_NONBLOCK)
        except NoAccess as e:
            denied.append(str(e))
            return [{"id": "hyperx:098d", "name": "HyperX Cloud Alpha Wireless", "kind": "headset",
                     "source": "hyperx", "level": None, "charging": False, "status": "no-access",
                     "connection": "wireless"}]
        try:
            for cmd in (0x0B, 0x0C):
                os.write(fd, bytes([0x21, 0xBB, cmd, 0]) + bytes(27))
            data = b""
            end = time.monotonic() + 0.45
            while time.monotonic() < end:
                r, _, _ = select.select([fd], [], [], 0.12)
                if r:
                    try:
                        data += os.read(fd, 64)
                    except BlockingIOError:
                        pass
            level, charging = parse_hyperx(data)
        except OSError:
            level, charging = None, None
        finally:
            os.close(fd)
        if level is not None:
            return [{"id": "hyperx:098d", "name": "HyperX Cloud Alpha Wireless", "kind": "headset",
                     "source": "hyperx", "level": level, "charging": bool(charging),
                     "status": "charging" if charging else "discharging", "connection": "wireless"}]
    return []


# ---------------------------------------------------------------- openrazer


def razer() -> list[dict]:
    out = []
    for level_path in sorted(glob.glob("/sys/bus/hid/drivers/razer*/*/charge_level")):
        base = os.path.dirname(level_path)
        raw = _read_text(level_path)
        if not raw.isdigit():
            continue
        level = round(int(raw) * 100 / 255)
        charging = _read_text(os.path.join(base, "charge_status")) == "1"
        dtype = _read_text(os.path.join(base, "device_type"))
        kind = "mouse"
        for word, k in (("keyboard", "keyboard"), ("headset", "headset"), ("controller", "gaming-input")):
            if word in dtype.lower():
                kind = k
        out.append({
            "id": "razer:" + os.path.basename(base),
            "name": dtype or "Razer device",
            "kind": kind,
            "source": "razer",
            "level": level,
            "charging": charging,
            "status": "charging" if charging else ("full" if level >= 100 else "discharging"),
            "connection": "wireless",
        })
    return out


# ------------------------------------------------------------ JBL speakers

# The JBL Portable app reads Charge 5, Boombox 3 and their siblings through a
# GATT service ExcelPoint built for Harman (protocol from ffrafat/JBLControl).
# Over Bluetooth Classic the speaker serves it on the ATT channel, L2CAP PSM 31,
# beside the audio, so reading it needs no LE link and leaves playback alone.
JBL_UUID_PREFIX = "65786365-6c70-6f69-6e74-"
JBL_RX = uuid.UUID("65786365-6c70-6f69-6e74-2e636f6d0001").bytes[::-1]
JBL_TX = uuid.UUID("65786365-6c70-6f69-6e74-2e636f6d0002").bytes[::-1]
JBL_INFO_REQUEST = b"\xaa\x11\x00"
JBL_MODEL = 0x42
JBL_BATTERY = 0x44
ATT_PSM = 31
# Token 42's product IDs, from JBLControl's catalogue of the JBL Portable app.
JBL_MODELS = {
    0x0023: "JBL Flip 3", 0x0024: "JBL Xtreme", 0x1EBC: "JBL Charge 3", 0x1ED1: "JBL Flip 4",
    0x1ED2: "JBL Pulse 3", 0x1EE7: "JBL Boombox", 0x1EFC: "JBL Xtreme 2", 0x1F17: "JBL Charge 4",
    0x1F26: "JBL Xtreme 2", 0x1F27: "JBL Boombox", 0x1F29: "JBL Charge 4", 0x1F31: "JBL Flip 5",
    0x1F53: "JBL Boombox 2", 0x1F56: "JBL Pulse 4", 0x202F: "JBL Xtreme 3", 0x2038: "JBL Xtreme 2",
    0x2040: "JBL Charge 5", 0x204F: "JBL Flip 6", 0x2050: "JBL Pulse 5", 0x206D: "JBL Boombox 3",
    0x2075: "JBL Boombox 3 Wi-Fi", 0x208C: "JBL Charge 5 Wi-Fi", 0x20DC: "JBL Xtreme 4",
    0x20E3: "JBL Charge 6", 0x20E4: "JBL Go 4", 0x20F5: "JBL Clip 5", 0x2107: "JBL Flip 7",
    0x210A: "JBL Go 4", 0x214C: "JBL Tuner 3", 0x215C: "JBL Go 4 Duo", 0x2181: "JBL Go 4 Duo",
}


def parse_jbl_info(data: bytes) -> dict | None:
    """The AA 12 info frames that answer AA 11 00: AA 12 <len> 00 <token> <value...>.
    Battery is token 44: the low seven bits are the level, the top bit is charging.
    Token 42, sent before it, is the product ID that names the model."""
    model = None
    i = 0
    while i + 3 <= len(data):
        if data[i] != 0xAA:
            i += 1
            continue
        cmd, length = data[i + 1], data[i + 2]
        payload = data[i + 3:i + 3 + length]
        if cmd == 0x12 and len(payload) >= 4 and payload[1] == JBL_MODEL:
            model = JBL_MODELS.get(payload[2] << 8 | payload[3])
        elif cmd == 0x12 and len(payload) >= 3 and payload[1] == JBL_BATTERY:
            level = payload[2] & 0x7F
            if level <= 100:
                return {"level": level, "charging": bool(payload[2] & 0x80), "model": model}
        i += 3 + length
    return None


def _att(sock: socket.socket, pdu: bytes, want: int) -> bytes | None:
    sock.send(pdu)
    while True:
        r = sock.recv(1024)
        if r and r[0] == want:
            return r
        if r and r[0] == 0x01:  # error response
            return None


def jbl_read(address: str) -> dict | None:
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
    sock.settimeout(1.5)
    try:
        sock.connect((address, ATT_PSM))
        # Read By Type on characteristic declarations: handle, properties, value handle, UUID.
        rx = tx = None
        start = 1
        while start <= 0xFFFF and (rx is None or tx is None):
            r = _att(sock, struct.pack("<BHHH", 0x08, start, 0xFFFF, 0x2803), 0x09)
            if not r:
                break
            step = r[1]
            for i in range(2, len(r) - step + 1, step):
                decl, _, value = struct.unpack("<HBH", r[i:i + 5])
                if r[i + 5:i + step] == JBL_RX:
                    rx = value
                elif r[i + 5:i + step] == JBL_TX:
                    tx = value
                start = decl + 1
        if rx is None or tx is None:
            return None
        # Turn on notifications through the client configuration descriptor (2902).
        r = _att(sock, struct.pack("<BHH", 0x04, rx + 1, rx + 4), 0x05)
        if not r or r[1] != 1:
            return None
        cccd = next((struct.unpack("<H", r[i:i + 2])[0] for i in range(2, len(r) - 3, 4)
                     if r[i + 2:i + 4] == b"\x02\x29"), None)
        if cccd is None or not _att(sock, struct.pack("<BHH", 0x12, cccd, 1), 0x13):
            return None
        sock.send(struct.pack("<BH", 0x52, tx) + JBL_INFO_REQUEST)
        # The answer is a burst of notifications, and one frame can span two.
        data = b""
        end = time.monotonic() + 1.5
        while time.monotonic() < end:
            r = sock.recv(1024)
            if len(r) > 3 and r[0] == 0x1B and struct.unpack("<H", r[1:3])[0] == rx:
                data += r[3:]
                found = parse_jbl_info(data)
                if found:
                    return found
        return None
    except OSError:
        return None
    finally:
        sock.close()


def bluez_devices() -> list[dict]:
    if not shutil.which("busctl"):
        return []
    try:
        res = subprocess.run(["busctl", "--json=short", "call", "org.bluez", "/",
                              "org.freedesktop.DBus.ObjectManager", "GetManagedObjects"],
                             capture_output=True, text=True, timeout=3)
        objects = json.loads(res.stdout)["data"][0]
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, IndexError):
        return []
    out = []
    for ifaces in objects.values():
        dev = ifaces.get("org.bluez.Device1")
        if dev:
            out.append({k: v.get("data") for k, v in dev.items()})
    return out


def jbl(devices: list[dict]) -> list[dict]:
    out = []
    for dev in devices:
        if not dev.get("Connected") or dev.get("AddressType") != "public":
            continue
        if not any(u.startswith(JBL_UUID_PREFIX) for u in dev.get("UUIDs") or []):
            continue
        reading = jbl_read(dev["Address"])
        if not reading:
            continue
        level, charging = reading["level"], reading["charging"]
        out.append({
            "id": "jbl:" + dev["Address"],
            "name": dev.get("Alias") or dev.get("Name") or reading["model"] or "JBL speaker",
            "model": reading["model"],
            "kind": "speakers",
            "source": "jbl",
            "level": level,
            "charging": charging,
            "status": "charging" if charging else ("full" if level >= 100 else "discharging"),
            "connection": "bluetooth",
        })
    return out


# ------------------------------------------------------------------ UPower

# The laptop's own battery comes from sysfs (see laptop()), not from here.
UPOWER_SKIP_KINDS = {"line-power", "battery", "monitor"}
UPOWER_STATES = {
    "charging": "charging",
    "pending-charge": "charging",
    "fully-charged": "full",
    "discharging": "discharging",
    "pending-discharge": "discharging",
    "empty": "discharging",
}


def parse_upower_dump(text: str) -> list[dict]:
    out = []
    for block in re.split(r"\n(?=Device: )", text):
        if not block.startswith("Device: ") or block.startswith("Device: /org/freedesktop/UPower/devices/DisplayDevice"):
            continue
        props: dict[str, str] = {}
        kind = ""
        for line in block.splitlines()[1:]:
            m = re.match(r"^\s+([a-z][a-z -]*?):\s+(.*)$", line)
            if m:
                props.setdefault(m.group(1), m.group(2).strip().strip("'"))
            elif re.match(r"^  [a-z-]+$", line):
                kind = line.strip()
        if not kind or kind in UPOWER_SKIP_KINDS or props.get("power supply") == "yes":
            continue
        if props.get("present", "yes") == "no":
            continue
        pm = re.match(r"(\d+(?:\.\d+)?)%", props.get("percentage", ""))
        level = round(float(pm.group(1))) if pm else None
        state = UPOWER_STATES.get(props.get("state", ""), "unknown")
        native = props.get("native-path", "")
        name = props.get("model") or props.get("vendor") or kind.replace("-", " ").title()
        connection = "bluetooth" if "bluez" in native or native.startswith("/org/bluez") else "wireless"
        out.append({
            "id": "upower:" + (native or block.splitlines()[0][8:]),
            "name": name,
            "kind": kind,
            "source": "upower",
            "level": level,
            "charging": state == "charging",
            "status": state if level is not None else "unknown",
            "connection": connection,
        })
    return out


def _duration(text: str) -> int | None:
    m = re.match(r"([\d.]+)\s+(second|minute|hour|day)", text or "")
    if not m:
        return None
    return round(float(m.group(1)) * {"second": 1, "minute": 60, "hour": 3600, "day": 86400}[m.group(2)])


def parse_upower_battery_times(text: str) -> dict:
    """UPower's smoothed time-to-empty/full for the laptop battery, by native path."""
    out = {}
    for block in re.split(r"\n(?=Device: )", text):
        native = re.search(r"^\s+native-path:\s+(\S+)", block, re.M)
        if not native or not re.search(r"^  battery$", block, re.M):
            continue
        times = {}
        for key, field in (("time to empty", "timeToEmpty"), ("time to full", "timeToFull")):
            m = re.search(r"^\s+%s:\s+(.*)$" % key, block, re.M)
            if m and _duration(m.group(1)):
                times[field] = _duration(m.group(1))
        out[native.group(1)] = times
    return out


def upower_dump() -> str:
    if not shutil.which("upower"):
        return ""
    try:
        return subprocess.run(["upower", "--dump"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ------------------------------------------------------------------ laptop

PS_ROOT = "/sys/class/power_supply"


def _num(path: str) -> int | None:
    raw = _read_text(path)
    try:
        return int(raw)
    except ValueError:
        return None


def laptop(upower_times: dict, root: str = PS_ROOT) -> dict | None:
    """The internal battery (all of them combined, on a two-battery laptop)."""
    bats = []
    ac_online = False
    for d in sorted(glob.glob(os.path.join(root, "*"))):
        kind = _read_text(os.path.join(d, "type"))
        scope = _read_text(os.path.join(d, "scope"))
        if kind in ("Mains", "USB") and _read_text(os.path.join(d, "online")) == "1" and scope != "Device":
            ac_online = True
        if kind == "Battery" and scope != "Device" and _read_text(os.path.join(d, "present")) != "0":
            bats.append(d)
    if not bats:
        return None

    energy = full = design = rate = 0.0
    statuses, cycles, names = [], [], []
    limit = start = None
    for d in bats:
        p = lambda f: os.path.join(d, f)
        volts = (_num(p("voltage_now")) or 0) / 1e6
        if _num(p("energy_now")) is not None:
            e, f, fd = _num(p("energy_now")), _num(p("energy_full")), _num(p("energy_full_design"))
            scale = 1e6
        else:
            # charge_* is in µAh; with the voltage it is µWh.
            e, f, fd = _num(p("charge_now")), _num(p("charge_full")), _num(p("charge_full_design"))
            scale = 1e6 / volts if volts else None
        if scale:
            energy += (e or 0) / scale
            full += (f or 0) / scale
            design += (fd or 0) / scale
        power = _num(p("power_now"))
        if power:
            rate += abs(power) / 1e6
        elif _num(p("current_now")) and volts:
            rate += abs(_num(p("current_now"))) / 1e6 * volts
        statuses.append(_read_text(p("status")))
        c = _num(p("cycle_count"))
        if c:
            cycles.append(c)
        limit = _num(p("charge_control_end_threshold")) or limit
        start = _num(p("charge_control_start_threshold")) or start
        names.append(os.path.basename(d))

    if full > 0:
        level = round(energy / full * 100)
    else:
        caps = [_num(os.path.join(d, "capacity")) for d in bats]
        level = round(sum(c for c in caps if c is not None) / max(1, len([c for c in caps if c is not None])))
    level = max(0, min(100, level))

    if "Charging" in statuses:
        status = "charging"
    elif "Discharging" in statuses and not ac_online:
        status = "discharging"
    elif all(s == "Full" for s in statuses) or level >= 100:
        status = "full"
    elif ac_online and limit and limit < 100 and level >= limit - 2:
        # Plugged in and the firmware stopped at the charge limit on purpose.
        status = "held"
    elif ac_online:
        status = "plugged"
    else:
        status = "discharging"

    times = {}
    for n in names:
        times.update(upower_times.get(n, {}))
    time_to_empty = time_to_full = None
    if status == "discharging":
        time_to_empty = times.get("timeToEmpty") or (round(energy / rate * 3600) if rate > 0.1 else None)
    elif status == "charging":
        target = full * (limit / 100 if limit else 1)
        time_to_full = times.get("timeToFull") or (round(max(0, target - energy) / rate * 3600) if rate > 0.1 else None)

    return {
        "level": level,
        "status": status,
        "charging": status == "charging",
        "acOnline": ac_online,
        "rateW": round(rate, 1) if status in ("charging", "discharging") else 0.0,
        "timeToEmpty": time_to_empty,
        "timeToFull": time_to_full,
        "energyWh": round(energy, 1),
        "energyFullWh": round(full, 1),
        "energyDesignWh": round(design, 1),
        "health": round(full / design * 100) if design > 0 else None,
        "cycles": sum(cycles) if cycles else None,
        "chargeLimit": limit if limit and limit < 100 else None,
        "chargeStart": start if start and limit and limit < 100 else None,
        "batteries": names,
    }


# ----------------------------------------------------------------- AirPods

LIBREPODS_STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "librepods", "status.json")


def _pod(raw) -> dict | None:
    if not isinstance(raw, dict) or not raw.get("available"):
        return None
    level = raw.get("level")
    if not isinstance(level, int) or not 0 <= level <= 100:
        return None
    pod = {"level": level, "charging": raw.get("charging") is True}
    if "in_ear" in raw:
        pod["inEar"] = raw.get("in_ear") is True
    return pod


def parse_librepods(text: str) -> dict | None:
    """The librepods daemon's status line. None when the daemon is not running."""
    try:
        s = json.loads(text)
    except ValueError:
        return None
    if not isinstance(s, dict) or "schema_version" not in s:
        return None
    is_headset = s.get("is_headset") is True
    parts = {"left": _pod(s.get("left")), "right": _pod(s.get("right")), "case": _pod(s.get("case"))}
    headset = _pod(s.get("headset")) if is_headset else None
    buds = [p for p in (parts["left"], parts["right"]) if p]
    if is_headset:
        level = headset["level"] if headset else None
        charging = bool(headset and headset["charging"])
    else:
        # The bar shows the emptier bud: that is the one that ends the session.
        level = min(p["level"] for p in buds) if buds else None
        charging = bool(buds) and all(p["charging"] for p in buds)
    return {
        "name": s.get("device_name") or s.get("model_name") or "AirPods",
        "model": s.get("model_name") or "",
        "connected": s.get("connected") is True,
        "isHeadset": is_headset,
        "isPro": s.get("is_pro_series") is True,
        "left": parts["left"],
        "right": parts["right"],
        "case": parts["case"],
        "headset": headset,
        "level": level,
        "charging": charging,
        "known": level is not None or parts["case"] is not None,
    }


def airpods(path: str = LIBREPODS_STATE) -> dict | None:
    try:
        with open(path, encoding="utf-8") as f:
            return parse_librepods(f.read())
    except OSError:
        return None


# ---------------------------------------------------- phones and tablets


def parse_ideviceinfo(text: str) -> dict:
    out = {}
    for line in text.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            out[k.strip()] = v.strip()
    return out


def iphone() -> list[dict]:
    if not shutil.which("idevice_id") or not shutil.which("ideviceinfo"):
        return []
    try:
        ids = subprocess.run(["idevice_id", "-l"], capture_output=True, text=True, timeout=3).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for udid in ids:
        try:
            info = parse_ideviceinfo(subprocess.run(["ideviceinfo", "-u", udid], capture_output=True, text=True, timeout=4).stdout)
            batt = parse_ideviceinfo(subprocess.run(["ideviceinfo", "-u", udid, "-q", "com.apple.mobile.battery"],
                                                    capture_output=True, text=True, timeout=4).stdout)
        except (OSError, subprocess.TimeoutExpired):
            continue
        level = batt.get("BatteryCurrentCapacity", "")
        if not level.isdigit():
            continue
        charging = batt.get("BatteryIsCharging") == "true"
        cls = info.get("DeviceClass", "iPhone")
        out.append({
            "id": "iphone:" + udid,
            "name": info.get("DeviceName") or cls,
            "kind": "tablet" if cls == "iPad" else "phone",
            "source": "iphone",
            "level": int(level),
            "charging": charging,
            "status": "charging" if charging else ("full" if level == "100" else "discharging"),
            "connection": "usb",
        })
    return out


def parse_kdeconnect_battery(text: str) -> tuple[int | None, bool]:
    charge = re.search(r"'charge':\s*<(-?\d+)>", text)
    charging = re.search(r"'isCharging':\s*<(true|false)>", text)
    level = int(charge.group(1)) if charge and 0 <= int(charge.group(1)) <= 100 else None
    return level, bool(charging and charging.group(1) == "true")


def kdeconnect() -> list[dict]:
    if not shutil.which("kdeconnect-cli") or not shutil.which("gdbus"):
        return []
    try:
        lines = subprocess.run(["kdeconnect-cli", "-a", "--id-name-only"], capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for line in lines.splitlines():
        dev_id, _, name = line.strip().partition(" ")
        if not dev_id:
            continue
        try:
            res = subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.kdeconnect",
                                  "--object-path", "/modules/kdeconnect/devices/%s/battery" % dev_id,
                                  "--method", "org.freedesktop.DBus.Properties.GetAll",
                                  "org.kde.kdeconnect.device.battery"], capture_output=True, text=True, timeout=3).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        level, charging = parse_kdeconnect_battery(res)
        if level is None:
            continue
        out.append({
            "id": "kdeconnect:" + dev_id,
            "name": name or "Phone",
            "kind": "phone",
            "source": "kdeconnect",
            "level": level,
            "charging": charging,
            "status": "charging" if charging else ("full" if level >= 100 else "discharging"),
            "connection": "wireless",
        })
    return out


# ----------------------------------------------------------- HeadsetControl


def parse_headsetcontrol(text: str) -> list[dict]:
    try:
        data = json.loads(text)
    except ValueError:
        return []
    out = []
    for d in data.get("devices", []):
        battery = d.get("battery") or {}
        bstatus = str(battery.get("status", ""))
        if d.get("status") != "success" or bstatus in ("", "BATTERY_UNAVAILABLE"):
            continue
        level = battery.get("level")
        level = int(level) if isinstance(level, (int, float)) and 0 <= level <= 100 else None
        charging = bstatus == "BATTERY_CHARGING"
        out.append({
            "id": "headsetcontrol:%s:%s" % (d.get("id_vendor", ""), d.get("id_product", "")),
            "name": d.get("product") or d.get("device") or "Headset",
            "kind": "headset",
            "source": "headsetcontrol",
            "level": level,
            "charging": charging,
            "status": "charging" if charging else "discharging",
            "connection": "wireless",
        })
    return out


def headsetcontrol() -> list[dict]:
    if not shutil.which("headsetcontrol"):
        return []
    try:
        res = subprocess.run(["headsetcontrol", "-o", "json"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_headsetcontrol(res.stdout)


# -------------------------------------------------------------------- main


def _key(name: str) -> str:
    return re.sub(r"[^a-z0-9]", "", name.lower())


def merge(groups: list[list[dict]], skip_names: tuple[str, ...] = ()) -> list[dict]:
    """First source wins when two report the same device name."""
    seen: set[str] = {_key(n) for n in skip_names if n}
    out = []
    for group in groups:
        for dev in group:
            key = _key(dev["name"])
            if key in seen:
                continue
            seen.add(key)
            out.append(dev)
    return out


def probe() -> dict:
    nodes = hidraw_nodes()
    denied: list[str] = []
    dump = upower_dump()
    pods = airpods()
    groups = [
        glorious_wireless(nodes, denied),
        glorious_wired(nodes, denied),
        hyperx(nodes, denied),
        razer(),
        jbl(bluez_devices()),
        parse_upower_dump(dump),
        headsetcontrol(),
        iphone(),
        kdeconnect(),
    ]
    return {
        "laptop": laptop(parse_upower_battery_times(dump)),
        # BlueZ also reports connected AirPods as one headset level; the
        # librepods reading has each bud and the case, so it wins.
        "airpods": pods,
        "devices": merge(groups, (pods["name"],) if pods else ()),
        "needsAccess": sorted(set(denied)),
        "udevInstalled": os.path.exists(UDEV_DEST) or os.path.exists(UDEV_LEGACY),
        "time": int(time.time()),
    }


def _hm(seconds: int | None) -> str:
    if not seconds:
        return ""
    return "%dh %02dm" % (seconds // 3600, seconds % 3600 // 60)


def cmd_list() -> int:
    result = probe()
    lap = result["laptop"]
    if lap:
        extra = [lap["status"]]
        if lap["rateW"]:
            extra.append("%.1f W" % lap["rateW"])
        if lap["timeToEmpty"] or lap["timeToFull"]:
            extra.append(_hm(lap["timeToEmpty"] or lap["timeToFull"]) + (" left" if lap["timeToEmpty"] else " to full"))
        if lap["health"]:
            extra.append("health %d%%" % lap["health"])
        if lap["chargeLimit"]:
            extra.append("limit %d%%" % lap["chargeLimit"])
        print("%-34s %-9s %4d%%%s  %s" % ("Laptop (" + "+".join(lap["batteries"]) + ")", "laptop",
                                          lap["level"], " ⚡" if lap["charging"] else "", ", ".join(extra)))
    pods = result["airpods"]
    if pods:
        def part(label, p):
            return "%s %s%s" % (label, "--" if not p else "%d%%" % p["level"], "⚡" if p and p["charging"] else "")
        parts = [part("Max", pods["headset"])] if pods["isHeadset"] else \
            [part("L", pods["left"]), part("R", pods["right"]), part("case", pods["case"])]
        print("%-34s %-9s %5s  %s, %s" % (pods["name"], "airpods", "--" if pods["level"] is None else "%d%%" % pods["level"],
                                          " ".join(parts), "connected" if pods["connected"] else "not connected"))
    for d in result["devices"]:
        level = "--" if d["level"] is None else "%d%%" % d["level"]
        bolt = " ⚡" if d["charging"] else ""
        print("%-34s %-9s %5s%s  %s, %s via %s" % (d["name"], d["kind"], level, bolt, d["status"], d["connection"], d["source"]))
    if not lap and not pods and not result["devices"]:
        print("No batteries found.")
    if result["needsAccess"]:
        print("\nNo access to " + ", ".join(result["needsAccess"]) + ". Run: sudo %s install-udev" % os.path.realpath(__file__))
    return 0


def cmd_install_udev() -> int:
    if os.geteuid() != 0:
        print("install-udev must run as root (sudo or pkexec).", file=sys.stderr)
        return 1
    if os.path.exists(UDEV_LEGACY):
        os.remove(UDEV_LEGACY)
    shutil.copyfile(UDEV_RULES, UDEV_DEST)
    os.chmod(UDEV_DEST, 0o644)
    subprocess.run(["udevadm", "control", "--reload-rules"], check=False)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=hidraw", "--action=change"], check=False)
    print("Installed " + UDEV_DEST)
    return 0


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else "probe"
    if cmd == "probe":
        print(json.dumps(probe()))
        return 0
    if cmd == "list":
        return cmd_list()
    if cmd == "install-udev":
        return cmd_install_udev()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
